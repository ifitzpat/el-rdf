@node Features
@chapter Features

@itemize
@item
@strong{@strong{In-memory RDF storage}} with efficient triple-indexed access
@item
@strong{@strong{SPARQL-like query language}} with pattern matching and variables
@item
@strong{@strong{Comprehensive CRUD operations}} - Create, Read, Update, Delete
@item
@strong{@strong{Graph visualization}} via Graphviz DOT format export
@end itemize

@emph{Key query operations:}

@itemize
@item
@strong{@strong{SELECT}} - Extract variable bindings from query results
@item
@strong{@strong{ASK}} - Boolean queries returning true/false
@item
@strong{@strong{CONSTRUCT}} - Build new triples from query results
@item
@strong{@strong{FILTER}} - Apply custom predicates to filter results
@item
@strong{@strong{DELETE-DATA}} - Pattern based deletion
@end itemize

