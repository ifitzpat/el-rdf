@node Core Functions
@section Core Functions

@itemize
@item
@samp{make-graph} - Create a new empty graph
@item
@samp{add-triple} (triple graph) - Add a single triple  
@item
@samp{add-triples} (triplist graph) - Add multiple triples
@item
@samp{delete-triple} (triple graph) - Delete a single triple
@item
@samp{delete-triples} (triplist graph) - Delete multiple triples
@item
@samp{delete-data} (where graph) - Pattern-based deletion
@end itemize

@node Query Functions
@section Query Functions

@itemize
@item
@samp{graph-query} (clauses graph &optional bindings) - Core query function (aliased as @samp{where})
@item
@samp{ask} (where graph) - Boolean queries
@item
@samp{select} (binding-list where) - SELECT queries  
@item
@samp{construct} (clauses where) - CONSTRUCT queries
@item
@samp{filter} (predicate bindinglist) - Filter results
@end itemize

@node Utility Functions
@section Utility Functions

@itemize
@item
@samp{triples} (pattern graph) - Retrieve triples matching pattern
@item
@samp{save-graph} (graph filename) - Save graph to file
@item
@samp{load-graph} (graph filename) - Load graph from file
@item
@samp{render-graph} (triples filename &optional styles) - Export to SVG
@item
@samp{render-graph-json} (triples filename &optional styles) - Export to JSON
@end itemize

